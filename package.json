{
  "name": "hearth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hearth — a personal property agent that helps London renters find homes that fit the life inside them.",
  "scripts": {
    "dev": "portless",
    "dev:app": "next dev",
    "build": "next build",
    "start": "next start --port=${PORT:-3000}",
    "lint": "oxlint app components data features lib --fix",
    "lint:check": "oxlint app components data features lib",
    "format": "oxfmt app components data features lib --write",
    "format:check": "oxfmt app components data features lib --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run --passWithNoTests",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "oxfmt": "0.56.0",
    "oxlint": "^1.71.0",
    "portless": "0.15.6",
    "postcss": "^8.5",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.30.3",
  "portless": {
    "name": "hearth",
    "script": "dev:app"
  }
}
